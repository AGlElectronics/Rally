# syntax=docker/dockerfile:1.7
#
# Rally frontend image (the staff app, or with RALLY_APP=submit the public
# submission site). Rsbuild builds a static bundle; nginx serves it
# and forwards /api/ to the backend.
#
# The image is the same for every installation: the sign-in address and the
# other web app settings are read at start-up from /config.json, which nginx
# serves from /etc/conservices/config.json. Mount your own file there (a
# ConfigMap in Kubernetes, a bind mount in Docker Compose). The default file
# below names no domain, so an unconfigured app says "Not configured yet".
# Docs: https://aglelectronics.github.io/con-services/modules/rally/configuration/#web-app-settings-configjson
#
# Build context: the module directory, for example
#   docker build -f infra/Dockerfile.frontend -t rally-frontend .

FROM node:22-alpine AS build
WORKDIR /src

COPY frontend/package.json frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm install --no-audit --no-fund

COPY frontend/ ./

# Release version shown in the app; CI passes it on tag builds.
ARG RALLY_VERSION=dev
# staff (default) or submit: which app this image serves.
ARG RALLY_APP=staff
ENV RALLY_VERSION=$RALLY_VERSION \
    RALLY_APP=$RALLY_APP

RUN npm run build

# nginx-unprivileged runs as the "nginx" user (UID 101) and listens on 8080:
# a non-root process cannot bind ports below 1024. The pid file and the
# temporary files live in /tmp. The upgrade picks up Alpine security fixes
# published after the base image was built.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine AS runtime
USER root
RUN apk upgrade --no-cache
COPY --from=build /src/dist /usr/share/nginx/html
ARG NGINX_CONF=nginx.conf
COPY infra/${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY infra/frontend-config/default.json /etc/conservices/config.json
# Security headers (the shared templates). At start-up the image's envsubst
# step fills in the origins and writes both snippets; the copies baked in
# here (no outside origins) are used where that directory is read-only.
# EXTRA_FRAME_SRC stays empty: Rally does not frame sandboxed HTML.
COPY infra/security-headers.conf.template /etc/nginx/templates/security-headers.conf.template
COPY infra/security-headers-frame-self.conf.template /etc/nginx/templates/security-headers-frame-self.conf.template
RUN mkdir -p /etc/nginx/snippets \
 && for t in security-headers security-headers-frame-self; do \
      sed -E 's/ *\$\{[A-Z_]+\}//g' /etc/nginx/templates/$t.conf.template \
        > /etc/nginx/snippets/$t.conf; \
    done \
 && chown -R 101:101 /etc/nginx/snippets
ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/snippets \
    NGINX_ENVSUBST_FILTER='^(KEYCLOAK_ORIGIN|DEN_ORIGIN|S3_ORIGIN|EXTRA_CONNECT_SRC|EXTRA_FRAME_SRC)$' \
    KEYCLOAK_ORIGIN="" \
    DEN_ORIGIN="" \
    S3_ORIGIN="" \
    EXTRA_CONNECT_SRC="" \
    EXTRA_FRAME_SRC=""
USER 101
EXPOSE 8080
