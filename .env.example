# Rally — local development environment.
#
# Copy to `.env`, adjust what you need, then `docker compose -f infra/docker-compose.yml up`.
# Port offsets vs Stash: backend 8100, frontend 3002, postgres 5435, minio 9020/9021.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8100
HTTP_ADDR=:8100

# PostgreSQL (matches infra/docker-compose.yml defaults).
DATABASE_URL=postgres://rally:rally@localhost:5435/rally?sslmode=disable

# ---------------------------------------------------------------------------
# Object storage — any S3-compatible API.
# LOCAL DEV: MinIO on localhost:9020 (started by the compose stack).
# PRODUCTION: a managed bucket — AWS S3, GCS S3 interop, etc. See
# docs/adr/0004-minio-never-production.md.
# ---------------------------------------------------------------------------
S3_ENABLED=true
S3_ENDPOINT=http://localhost:9020
S3_BUCKET=events-data-dev
S3_ACCESS_KEY_ID=rally
S3_SECRET_ACCESS_KEY=rallyrally
S3_REGION=us-east-1
# MinIO and many self-hosted endpoints need true; most AWS deployments use false.
S3_USE_PATH_STYLE=true
# Optional: rewrite the presigned URL host so a browser can reach them.
S3_PUBLIC_BASE_URL=http://localhost:9020

# ---------------------------------------------------------------------------
# Auth
#   dev  — X-Dev-User header; subject "dev-admin" seeded by the init migration.
#   oidc — Bearer JWT verified via OIDC discovery (set issuer + client id).
# ---------------------------------------------------------------------------
AUTH_MODE=dev
DEV_DEFAULT_USER=dev-admin
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Access config file (roles & OIDC-group → role bindings). Optional in dev
# (the built-in catalog is used), required for production OIDC deployments.
# ACCESS_CONFIG_PATH=/etc/rally/access-config.toml

# ---------------------------------------------------------------------------
# Branding
#   Standalone: the local brand.json below (or the built-in default).
#   Paired with Den (Organizations → Den connection): Den's name, logo and
#   colours override it; the pairing is stored in the database.
# ---------------------------------------------------------------------------
# Optional: path to a server-side brand.json for /api/v1/brand.
BRAND_LOCAL_PATH=
# Optional: replaces the host of the pasted Den pairing URL when this backend
# reaches Den at a different address than the browser does.
DEN_INTERNAL_URL=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3002
SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Frontend (rsbuild inlines these at build time; set BEFORE building the image).
# ---------------------------------------------------------------------------
# Leave empty when the SPA is served behind the same origin as /api (nginx).
VITE_API_BASE_URL=http://localhost:8100
VITE_AUTH_MODE=dev
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_PRODUCT_NAME=Rally
